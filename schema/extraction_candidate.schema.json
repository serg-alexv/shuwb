{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuwb/schema/extraction_candidate.schema.json",
  "title": "shuwb extraction candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["document", "candidates", "warnings"],
  "properties": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_type"],
      "properties": {
        "source_id": {"type": "string"},
        "source_type": {"type": "string"},
        "case_id_hint": {"type": ["string", "null"]},
        "document_date": {"type": ["string", "null"]}
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "entity_type",
          "field_or_relation",
          "value",
          "epistemic_state",
          "source_locator",
          "source_span",
          "confidence"
        ],
        "properties": {
          "candidate_id": {"type": "string"},
          "entity_type": {"type": "string"},
          "entity_id_hint": {"type": ["string", "null"]},
          "field_or_relation": {"type": "string"},
          "value": {},
          "actor_role": {"type": ["string", "null"]},
          "issue_code": {"type": ["string", "null"]},
          "claim_component_type": {"type": ["string", "null"]},
          "epistemic_state": {
            "type": "string",
            "enum": ["CONFIRMED", "INFERRED", "UNKNOWN", "NOT_APPLICABLE", "NOT_REACHED"]
          },
          "source_locator": {"type": "string"},
          "source_span": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "extraction_note": {"type": ["string", "null"]}
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
